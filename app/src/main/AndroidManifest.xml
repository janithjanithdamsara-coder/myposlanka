<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher_background"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_background"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PosSystem">

        <!-- ZXing Capture Activity -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <!-- Splash / Landing Screen (First Launching Screen) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activation Screen (First Launching Setup) -->
        <activity
            android:name=".ActivationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Subscription Locked / Expiry Screen -->
        <activity
            android:name=".SubscriptionLockedActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Login Screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Returns & Refunds Activity -->
        <activity
            android:name=".ReturnsActivity"
            android:exported="false" />

        <!-- Main Dashboard Screen with Navigation Drawer -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- POS Billing Screen -->
        <activity
            android:name=".PosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Product Catalog Screen -->
        <activity
            android:name=".ProductsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Product Form Screen -->
        <activity
            android:name=".AddProductActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Inventory Alert Center Screen -->
        <activity
            android:name=".InventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Purchases History Screen -->
        <activity
            android:name=".PurchasesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Purchase Entry Screen -->
        <activity
            android:name=".AddPurchaseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Customer Credit Ledger Screen -->
        <activity
            android:name=".CreditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Customers Directory Screen -->
        <activity
            android:name=".CustomersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Expense Tracker Screen -->
        <activity
            android:name=".ExpensesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Reports Screen -->
        <activity
            android:name=".ReportsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Settings Screen -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Receipt Preview Screen -->
        <activity
            android:name=".ReceiptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>