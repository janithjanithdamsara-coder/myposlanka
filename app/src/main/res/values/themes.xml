<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme forced to Light for consistent retail UI -->
    <style name="Base.Theme.PosSystem" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryVariant">@color/green_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/green_primary_light</item>
        <item name="colorSecondaryVariant">@color/green_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Surface colors forced to white -->
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/green_primary_dark</item>
        <!-- Text & Hint Colors -->
        <item name="android:textColorHint">#6B7280</item>
        <item name="android:editTextColor">@color/black</item>
        <!-- Background color -->
        <item name="android:windowBackground">@color/green_bg_light</item>
    </style>

    <style name="Theme.PosSystem" parent="Base.Theme.PosSystem" />

    <!-- Splash Screen Theme -->
    <style name="Theme.Splash" parent="Base.Theme.PosSystem">
        <item name="android:windowBackground">@drawable/bg_green_gradient</item>
        <item name="android:statusBarColor">@color/green_primary_dark</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/green_primary_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
    </style>

    <!-- Active Indicator Pill for Bottom Navigation Bar -->
    <style name="BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_card_bg</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- Master Button Styles (14dp Radius, 52dp Height Standard) -->
    <style name="GreenButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="GreenAccentButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_primary_light</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="OutlinedGreenButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/green_primary</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>