<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/green_bg_light"
    android:orientation="vertical">

    <!-- Top Embedded Camera Scanner Viewfinder (Matches Screen Recording) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="#1B5E20">

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/barcodeScannerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Green "Scan accepted" Animated Toast Badge -->
        <TextView
            android:id="@+id/tvScanAcceptedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_button_pill"
            android:elevation="6dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="✓ Scan accepted"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Search Pill Bar & Checkout Fast Access Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_dashboard"
            app:tint="@color/white" />

        <!-- Search Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/green_primary" />

            <AutoCompleteTextView
                android:id="@+id/etPOSSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:completionThreshold="1"
                android:popupBackground="@color/white"
                android:dropDownVerticalOffset="8dp"
                android:hint="Search by name or code..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/black"
                android:textColorHint="#757575"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnScanBarcodePOS"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_button_pill_accent"
                android:padding="5dp"
                android:src="@drawable/ic_barcode_scan"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Fast Checkout Pill Button -->
        <Button
            android:id="@+id/btnCheckoutTopPill"
            style="@style/GreenAccentButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingHorizontal="12dp"
            android:text="Checkout"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Category Chips Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <Button
                style="@style/GreenButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="16dp"
                android:text="All Items"
                android:textSize="12sp" />

            <Button
                style="@style/OutlinedGreenButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="16dp"
                android:text="Weight Based (Kg/g)"
                android:textSize="12sp" />

            <Button
                style="@style/OutlinedGreenButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="16dp"
                android:text="Dairy &amp; Milk"
                android:textSize="12sp" />

            <Button
                style="@style/OutlinedGreenButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="16dp"
                android:text="Beverages"
                android:textSize="12sp" />

            <Button
                style="@style/OutlinedGreenButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="16dp"
                android:text="Snacks &amp; Biscuits"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Cart Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Bill Cart"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCartItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_badge_in_stock"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="3 Items"
            android:textColor="@color/green_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- RecyclerView Cart Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCartItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp" />

    <!-- Bottom Billing Summary Card (20dp Curved Material Card) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Subtotal & Discount Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Subtotal:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPOSSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 3,250.00"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bill Discount:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPOSDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- LKR 100.00"
                    android:textColor="@color/red_alert"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/divider_color" />

            <!-- Grand Total Highlight -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TOTAL DUE:"
                    android:textColor="@color/green_primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPOSGrandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LKR 3,150.00"
                    android:textColor="@color/green_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- POS Action Buttons (Hold, Clear, Pay) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnHoldBill"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="0.8"
                    android:text="Hold"
                    android:textColor="@color/orange_warning"
                    android:textSize="13sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/orange_warning" />

                <Button
                    android:id="@+id/btnClearCart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="0.8"
                    android:text="Clear"
                    android:textColor="@color/red_alert"
                    android:textSize="13sp"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/red_alert" />

                <Button
                    android:id="@+id/btnPayPOS"
                    style="@style/GreenAccentButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1.4"
                    android:text="CHECKOUT"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
