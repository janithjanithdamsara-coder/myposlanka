<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/green_bg_light">

    <!-- Header with status bar padding -->
    <LinearLayout
        android:id="@+id/headerPurchases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnBackPurchases"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_dashboard"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Stock Purchases History / මිලදී ගැනීම්"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Box -->
    <LinearLayout
        android:id="@+id/layoutPurchaseSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/headerPurchases"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/green_primary" />

        <EditText
            android:id="@+id/etSearchPurchases"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Search purchase invoice # or supplier..."
            android:textColor="@color/black"
            android:textColorHint="#757575"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- RecyclerView Purchases -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPurchases"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutPurchaseSearch"
        android:clipToPadding="false"
        android:paddingBottom="80dp" />

    <!-- FAB Add Purchase -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddPurchase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:contentDescription="New Purchase"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/green_primary"
        app:tint="@color/white" />

</RelativeLayout>
