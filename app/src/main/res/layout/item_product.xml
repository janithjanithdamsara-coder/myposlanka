<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="12dp">

        <!-- Product Image Placeholder -->
        <ImageView
            android:id="@+id/ivProductImage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_badge_in_stock"
            android:padding="10dp"
            android:src="@drawable/ic_inventory"
            app:tint="@color/green_primary" />

        <!-- Main Product Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@id/layoutProductPriceStock"
            android:layout_toEndOf="@id/ivProductImage"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Samba Rice 1kg"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProductBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Barcode: 890123456789"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Category: Food • Unit: Kg"
                android:textColor="@color/green_primary_dark"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Price, Stock Status Pill & Delete Button -->
        <LinearLayout
            android:id="@+id/layoutProductPriceStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductSellingPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 280.00"
                android:textColor="@color/green_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Stock Pill Badge -->
                <TextView
                    android:id="@+id/tvProductStockPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_in_stock"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Stock: 45 kg"
                    android:textColor="@color/green_primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Delete Trash Button -->
                <ImageView
                    android:id="@+id/btnDeleteProduct"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_expiry"
                    android:padding="5dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/red_alert" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
